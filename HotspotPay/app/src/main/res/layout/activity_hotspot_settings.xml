<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Network"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:textSize="13sp"
        android:text="Android randomly generates the hotspot's network name and password each time it starts — there is no way for a regular app to set a custom one (that's restricted to system apps only, on every Android version). The generated name/password show up in the app's notification once the hotspot is running, so you can read them off to guests." />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Payments"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMmNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mobile money number (where guests send payment)"
        android:inputType="phone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="12sp"
        android:text="Sites to keep an eye on (your own reference list — not automatically blocked, see note below)" />

    <EditText
        android:id="@+id/etBlockedSites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:hint="e.g. one site per line" />

    <Button
        android:id="@+id/btnSavePayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Payment Settings" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Voucher Packages"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/packagesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/btnAddPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Add Package" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textSize="13sp"
        android:textColor="#888888"
        android:text="Data limits (MB/GB per guest) and site blocking aren't possible on a non-rooted phone — the app can't see individual guests' traffic. These become available if you move to a rooted device or a dedicated router (GL.iNet/OpenWrt)." />

</LinearLayout>
</ScrollView>
